<?xml version="1.0"?>
<!--
  SGC - Retaguarda web
  2011-04 criado (.NET 3.5)
  2019-08 retarget .NET 4.8 (TLS 1.2 exigido pelo banco)
-->
<configuration>
  <appSettings>
    <add key="NomeSistema" value="SGC - Sistema de Gestão de Consórcios"/>
    <add key="PastaLog" value="D:\SGC\Logs"/>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
    <!-- Migracao .NET 10: chave da ponte de sessao (Sessao/Quem.ashx). Em producao vem do cofre de segredos. -->
    <add key="PonteSessaoChave" value="dev-ponte-7f3a9c2e-troque-em-producao"/>
  </appSettings>
  <connectionStrings>
    <add name="SGC" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SGC;Integrated Security=True" providerName="System.Data.SqlClient"/>
    <!-- PRODUCAO - usar so em emergencia
    <add name="SGC" connectionString="Data Source=SRVSQL01;Initial Catalog=SGC;User ID=sa;Password=Cec0ns@2011" providerName="System.Data.SqlClient"/>
    -->
  </connectionStrings>
  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="10240"/>
    <globalization culture="pt-BR" uiCulture="pt-BR" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8"/>
    <sessionState mode="InProc" timeout="60"/>
    <authentication mode="None"/>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Erro.aspx"/>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" validateRequest="true">
      <namespaces>
        <add namespace="System.Data"/>
        <add namespace="System.Data.SqlClient"/>
        <add namespace="SGC.Comum"/>
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
