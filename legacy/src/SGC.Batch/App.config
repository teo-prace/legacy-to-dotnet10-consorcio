<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="SGC" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SGC;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <!-- usuario gravado nas baixas e no log -->
    <add key="CodigoUsuarioBatch" value="1"/>
  </appSettings>
</configuration>
