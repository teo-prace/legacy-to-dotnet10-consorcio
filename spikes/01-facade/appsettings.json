{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8100",
  "Migracao": {
    "ParcelasNoNovo": false
  },
  "ReverseProxy": {
    "Routes": {
      "legado": {
        "ClusterId": "legado",
        "Order": 2147483647,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "legado": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "iisexpress": { "Address": "http://localhost:8090/" }
        }
      }
    }
  }
}
