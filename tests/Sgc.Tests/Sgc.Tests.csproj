<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- compiled here instead of referenced: Smart App Control on the dev machine blocks freshly built library DLLs -->
    <Compile Include="..\..\spikes\05-shared-database\BaixaParcelas.cs" Link="Spikes\Code\BaixaParcelas.cs" />
    <!-- the billing rule of the new system, compiled as-is: parity tests run the exact source that ships -->
    <Compile Include="..\..\modern\src\Sgc.Novo\Billing\LateFees.cs" Link="Modern\Code\LateFees.cs" />
    <Compile Include="..\..\modern\src\Sgc.Novo\Billing\Boleto.cs" Link="Modern\Code\Boleto.cs" />
    <Compile Include="..\..\modern\src\Sgc.Novo\Billing\PaymentPosting.cs" Link="Modern\Code\PaymentPosting.cs" />
  </ItemGroup>

</Project>
