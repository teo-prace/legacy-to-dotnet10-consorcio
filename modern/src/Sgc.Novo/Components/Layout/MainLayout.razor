@inherits LayoutComponentBase
@inject IOptionsMonitor<MigrationSwitches> Switches

@* Same structure and CSS as the legacy Site.master: users don't notice the technology change (ADR-004). *@
<table class="topo" cellpadding="0" cellspacing="0">
    <tr>
        <td class="topoLogo">SGC <span>CeCons Consórcios</span>
            @if (Switches.CurrentValue.SeloTelaNova)
            {
                @* own inline style, so it doesn't depend on the legacy CSS *@
                <em class="seloTelaNova" style="font-style:normal;font-size:10px;font-weight:bold;letter-spacing:.5px;background:#f5c518;color:#1a1a1a;border-radius:3px;padding:2px 6px;margin-left:10px;vertical-align:middle"
                    title="Tela migrada para .NET 10. O visual é o mesmo do sistema anterior de propósito.">TELA NOVA · .NET 10</em>
            }
        </td>
        <td class="topoUsuario">@_name &nbsp;|&nbsp; @DateTime.Today.ToString("dd/MM/yyyy") &nbsp;|&nbsp; <a href="/Default.aspx" data-enhance-nav="false">Painel</a></td>
    </tr>
</table>
<table class="corpo" cellpadding="0" cellspacing="0">
    <tr>
        <td class="menu"><Menu /></td>
        <td class="conteudo">@Body</td>
    </tr>
</table>
<div class="rodape">SGC · CeCons Administradora de Consórcios</div>

@code {
    [CascadingParameter] Task<AuthenticationState>? Authentication { get; set; }
    string? _name;

    protected override async Task OnInitializedAsync()
    {
        if (Authentication is not null) _name = (await Authentication).User.FindFirstValue(ClaimTypes.Name);
    }
}
